{
  "name": "zizou-ai",
  "version": "1.3.2",
  "type": "module",
  "description": "An open-source AI coding agent CLI tool",
  "bin": {
    "zizou": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "dev-harness": "bun run src/dev-harness.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/ evals/",
    "build": "bun run build.ts",
    "eval": "bun run evals/run-evals.ts",
    "sft:build": "bun run evals/sft/build.ts",
    "sft:check": "bun run evals/sft/build.ts --dry-run",
    "sft:render": "bun run evals/sft/render.ts",
    "sft:csv": "bun run evals/sft/export-csv.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/groq": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "ai": "^7.0.0",
    "conf": "^12.0.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.1",
    "fuzzysort": "^3.1.0",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3"
  }
}
